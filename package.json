{
  "name": "odin-book",
  "version": "1.0.0",
  "private": true,
  "description": "Odin-Book: a social media site built with Express, EJS, Passport, Prisma and PostgreSQL",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "build": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "node prisma/seeds.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@quixo3/prisma-session-store": "^3.1.21",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "prisma": "^7.10.1"
  }
}
